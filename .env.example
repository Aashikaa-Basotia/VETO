# VETO Security Gateway Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production tokens to version control.

# ==============================================================================
# Provenance Cryptographic Secret (HMAC-SHA256)
# ==============================================================================
# The secret key shared between the trusted MCP server and VETO Gateway.
# In production, this MUST be a high-entropy secret provisioned via KMS, Vault, or SSM.
# If unset in development/local mode, VETO falls back to an explicit development secret
# with a prominent security warning. In production (VETO_ENVIRONMENT=production),
# missing or empty secrets fail closed immediately (HTTP 403 / BLOCK).
VETO_PROVENANCE_SECRET=replace-with-a-high-entropy-random-secret-key-in-production

# Environment Mode: 'local' (default) or 'production'
# When set to 'production', VETO disables development fallbacks and requires strict credentials.
VETO_ENVIRONMENT=local

# Explicit Development Fallback Control: '1' (allow dev fallback if secret unset) or '0' (strictly require secret)
VETO_ALLOW_DEV_FALLBACK=1

# Gateway Execution Context: 'normal' (default) or 'restricted'
# In 'restricted' mode, state-changing mutations are blocked regardless of agent policy.
VETO_EXECUTION_MODE=normal

# ==============================================================================
# Downstream Services and Storage
# ==============================================================================
# VETO Gateway URL
VETO_GATEWAY_URL=http://127.0.0.1:8001

# Downstream Internal Service URL
DOWNSTREAM_URL=http://127.0.0.1:8000

# SQLite Persistence Paths
VETO_AUDIT_DB=audit.db
VETO_REPLAY_DB=replay.db
VETO_APPROVAL_DB=approval.db
VETO_EMAIL_WATCHER_DB=email_watcher.db

# Email Watcher & Processor Configuration (Phases 1 & 2)
# Watcher polling interval in seconds (default: 30.0)
VETO_EMAIL_POLL_INTERVAL=30.0
# Processor polling interval in seconds (default: 10.0)
VETO_PROCESSOR_POLL_INTERVAL=10.0
# Maximum email body characters sent to LLM classifier (default: 10000)
VETO_EMAIL_MAX_BODY_CHARS=10000

# ==============================================================================
# Google Integrations (OAuth 2.0 & APIs)
# ==============================================================================
# Required for live Google Gmail API execution (Desktop Application OAuth client):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Mock / Bearer tokens (for deterministic automated test suites):
# VETO_GMAIL_ACCESS_TOKEN=mock_token
# VETO_CALENDAR_ACCESS_TOKEN=mock_token
